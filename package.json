{
  "name": "whl-guess",
  "private": true,
  "description": "WHL 竞猜系统 — CF Pages + Pages Functions + D1；发奖同步到 AstrBot 插件",
  "scripts": {
    "dev": "wrangler dev --port 8789",
    "deploy": "wrangler deploy",
